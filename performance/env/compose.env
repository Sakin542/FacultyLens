VITE_API_BASE_URL=/api
DB_DATABASE=facultylens
DB_USERNAME=facultylens_app
DB_PASSWORD=perf_db_pass
MYSQL_ROOT_PASSWORD=perf_root_pass
REDIS_PASSWORD=perf_redis_pass
TLS_CERT_DIR=./performance/env
