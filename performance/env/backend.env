# STEP 43 — backend environment for the LOCAL performance stack (docker-compose.prod.yml + performance/docker-compose.perf.yml).
# Production topology (php-fpm + opcache, Redis cache/queue, config cached) with throw-away credentials. Never use for real deployments.
APP_NAME=FacultyLens
APP_ENV=production
APP_KEY=base64:KFIbgSa55eP80rvrpGjnf3FprMFgKAvDiZoeph6l+nQ=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8090
FRONTEND_URL=http://127.0.0.1:8090
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8090,http://localhost:8090
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8090,localhost:8090
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120
TRUSTED_PROXIES=172.16.0.0/12
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_REQUESTS=true
LOG_SLOW_REQUEST_MS=2000
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=facultylens
DB_USERNAME=facultylens_app
DB_PASSWORD=perf_db_pass
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=perf_redis_pass
REDIS_PORT=6379
FILESYSTEM_DISK=local
REPORTS_DISK=local
REPORTS_EXPIRATION_DAYS=7
REPORTS_ASYNC_THRESHOLD=2000
AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_API_KEY=perf-ai-key-not-secret
AI_SERVICE_CONNECT_TIMEOUT=10
AI_SERVICE_TIMEOUT=120
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@facultylens.local
MAIL_FROM_NAME=FacultyLens
CHAT_RATE_LIMIT=30
QUESTION_GENERATION_RATE_LIMIT=10
COLLABORATION_INVITE_RATE_LIMIT=10
COLLABORATION_COMMENT_RATE_LIMIT=60
ALLOW_DEV_SEED=true
