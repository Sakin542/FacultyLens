APP_NAME="FacultyLens AI Service"
APP_ENV=local
DEBUG=true

AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001

# Hugging Face Model Configuration
HF_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
HF_TOKEN=
HF_HOME=./cache/huggingface

# Internal API Key for service-to-service communication (optional in local dev)
AI_SERVICE_API_KEY=

# STEP 25 AI Rubric Generator
# MiniLM above is an embedding model and cannot draft text. Rubric drafting uses a
# structured template engine by default. Optionally enable a small seq2seq model:
#   google/flan-t5-small (~300 MB download, ~1 GB RAM, CPU ok)
#   google/flan-t5-base  (~1 GB download,  ~2.5 GB RAM)
# Generated text is always validated; the template engine is used as fallback.
RUBRIC_GENERATION_ENABLED=false
RUBRIC_GENERATION_MODEL=
RUBRIC_GENERATION_MAX_NEW_TOKENS=192
RUBRIC_MAX_CRITERIA=8

# STEP 28 Answer <-> Rubric Alignment
# Thresholds on the combined semantic (MiniLM cosine) / lexical criterion signal that map to
# STRONG / PARTIAL / WEAK / NOT_ALIGNED. These are INITIAL engineering values, separate from the
# STEP 11 learning-outcome thresholds, and must be validated against faculty-reviewed examples.
RUBRIC_ALIGNMENT_STRONG_THRESHOLD=0.75
RUBRIC_ALIGNMENT_PARTIAL_THRESHOLD=0.55
RUBRIC_ALIGNMENT_WEAK_THRESHOLD=0.35

# STEP 32 AI Chat with Academic Documents (RAG)
# MiniLM (HF_MODEL_NAME) embeds document chunks and questions ONLY. Answers come from a
# separate generation model. Leave HF_GENERATION_MODEL empty to use the deterministic
# extractive answer engine (quotes the most relevant retrieved sentences, always cites sources).
#   google/flan-t5-base (~1 GB, CPU ok) / google/flan-t5-large (~3 GB) / any HF text2text or causal model
# Generated answers are validated (must cite [S#] sources, no leaked instructions) and fall back to extractive.
HF_GENERATION_MODEL=
HF_GENERATION_MAX_NEW_TOKENS=256
CHAT_TOP_K=5
CHAT_MIN_RELEVANCE_SCORE=0.35
CHAT_MAX_CONTEXT_CHARS=6000
CHAT_MAX_HISTORY_MESSAGES=10

