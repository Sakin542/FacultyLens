APP_NAME="FacultyLens AI Service"
APP_ENV=local
DEBUG=true

AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001

# Hugging Face Model Configuration
HF_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
HF_TOKEN=
HF_HOME=./cache/huggingface

# Internal API Key for service-to-service communication (optional in local dev)
AI_SERVICE_API_KEY=

# STEP 25 AI Rubric Generator
# MiniLM above is an embedding model and cannot draft text. Rubric drafting uses a
# structured template engine by default. Optionally enable a small seq2seq model:
#   google/flan-t5-small (~300 MB download, ~1 GB RAM, CPU ok)
#   google/flan-t5-base  (~1 GB download,  ~2.5 GB RAM)
# Generated text is always validated; the template engine is used as fallback.
RUBRIC_GENERATION_ENABLED=false
RUBRIC_GENERATION_MODEL=
RUBRIC_GENERATION_MAX_NEW_TOKENS=192
RUBRIC_MAX_CRITERIA=8

# STEP 28 Answer <-> Rubric Alignment
# Thresholds on the combined semantic (MiniLM cosine) / lexical criterion signal that map to
# STRONG / PARTIAL / WEAK / NOT_ALIGNED. These are INITIAL engineering values, separate from the
# STEP 11 learning-outcome thresholds, and must be validated against faculty-reviewed examples.
RUBRIC_ALIGNMENT_STRONG_THRESHOLD=0.75
RUBRIC_ALIGNMENT_PARTIAL_THRESHOLD=0.55
RUBRIC_ALIGNMENT_WEAK_THRESHOLD=0.35

# STEP 32 AI Chat with Academic Documents (RAG)
# MiniLM (HF_MODEL_NAME) embeds document chunks and questions ONLY. Answers come from a
# separate generation model. Leave HF_GENERATION_MODEL empty to use the deterministic
# extractive answer engine (quotes the most relevant retrieved sentences, always cites sources).
#   google/flan-t5-base (~1 GB, CPU ok) / google/flan-t5-large (~3 GB) / any HF text2text or causal model
# Generated answers are validated (must cite [S#] sources, no leaked instructions) and fall back to extractive.
HF_GENERATION_MODEL=Qwen/Qwen2.5-0.5B-Instruct
HF_GENERATION_MAX_NEW_TOKENS=256
CHAT_TOP_K=5
CHAT_MIN_RELEVANCE_SCORE=0.35
CHAT_MAX_CONTEXT_CHARS=6000
CHAT_MAX_HISTORY_MESSAGES=10

# STEP 33 Constrained Question Generator
# Reuses HF_GENERATION_MODEL above for drafting; when empty a constraint-driven template engine drafts
# questions from the topic / course outcome / retrieved document sentences. MiniLM stays embeddings-only
# (CO alignment + similarity validation). Drafts are always validated and reviewed by faculty.
QUESTION_GENERATION_MAX_NEW_TOKENS=512
QUESTION_GENERATION_MAX_QUESTIONS=20
QUESTION_GENERATION_ALIGNMENT_STRONG=0.70
QUESTION_GENERATION_ALIGNMENT_WEAK=0.50


# Optional hosted generation provider (OpenAI-compatible /chat/completions). Used only when the admin selects
# "Hosted" in Platform settings; otherwise the local model above is used. Academic text is sent to this provider.
#   Hugging Face Inference Providers: LLM_HOSTED_BASE_URL=https://router.huggingface.co/v1, key = HF token
#   Groq: https://api.groq.com/openai/v1   Google Gemini: https://generativelanguage.googleapis.com/v1beta/openai
#   OpenRouter: https://openrouter.ai/api/v1 (model e.g. anthropic/claude-opus-5.5)
# Calls go through LangChain (ChatOpenAI). With docker compose, put these in the git-ignored root .env instead.
LLM_HOSTED_BASE_URL=
LLM_HOSTED_API_KEY=
LLM_HOSTED_MODEL=
# Comma-separated models tried in order when LLM_HOSTED_MODEL fails (same base URL and key); local model is last
LLM_HOSTED_FALLBACK_MODELS=
LLM_HOSTED_TIMEOUT_SECONDS=60
LLM_HOSTED_MAX_RETRIES=1
# OpenRouter reasoning: low|medium|high = thinking effort (low is fast; works for all models), off = no thinking
# (Claude Opus and Gemini reject this), on = default thinking, empty = send nothing (non-OpenRouter providers)
LLM_HOSTED_REASONING=

# AI toolkit (local models, downloaded on first use)
OCR_MODEL=microsoft/trocr-base-handwritten
OCR_MAX_PAGES=10
ASR_MODEL=openai/whisper-large-v3-turbo
ASR_MAX_SECONDS=5400
# faster-whisper runs Whisper large-v3-turbo with 8-bit weights on all CPU cores and skips silence (several times
# faster); "transformers" uses ASR_MODEL through the HF pipeline, which is also the automatic fallback.
ASR_ENGINE=faster-whisper
ASR_FAST_MODEL=large-v3-turbo
TRANSLATION_MODEL=facebook/nllb-200-distilled-600M
TRANSLATION_MAX_CHARS=5000
# Hosted image/audio models for OCR and transcription (same base URL and key as above), tried in order when the
# admin selects "hosted"; TrOCR / Whisper run locally when they all fail. Answer sheets and recordings are sent to
# the provider. Recordings go in pieces of ASR_HOSTED_CHUNK_SECONDS, a few at a time.
LLM_VISION_MODELS=google/gemini-3.8-flash,anthropic/claude-haiku-5.5
# Empty = local Whisper only. OpenRouter accepts audio only with a balance of at least $0.50.
LLM_AUDIO_MODELS=
LLM_MEDIA_TIMEOUT_SECONDS=300
ASR_HOSTED_CHUNK_SECONDS=600
# English speech: kokoro (hexgrad/Kokoro-82M) or mms; Bangla always uses facebook/mms-tts-ben
TTS_ENGLISH_ENGINE=kokoro
TTS_KOKORO_VOICE=af_heart
# Bangla: edge = Microsoft neural voice via edge-tts (natural; needs internet; the text is sent to Microsoft's
# unofficial Edge read-aloud service and could stop working) or mms = facebook/mms-tts-ben (local). MMS is the fallback.
TTS_BANGLA_ENGINE=edge
TTS_BANGLA_VOICE=bn-BD-NabanitaNeural
# Answer similarity / plagiarism check embeddings (multilingual, ~2.3 GB, loaded on first use)
ANSWER_SIMILARITY_MODEL=BAAI/bge-m3
# Local model memory: unload models idle this long (0 = never), and unload the least recently used idle models
# before loading another so the process stays within the budget (0 = no budget). 5000 MB leaves room for MySQL,
# Laravel and the rest inside Docker Desktop's default ~7.5 GB; raise both if you give Docker more memory.
MODEL_IDLE_UNLOAD_SECONDS=900
MODEL_MEMORY_BUDGET_MB=5000
