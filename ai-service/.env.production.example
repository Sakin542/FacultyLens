# FacultyLens AI service — PRODUCTION template. The service must only be reachable from the Laravel
# container (private Docker network); it is never exposed to browsers.
APP_NAME="FacultyLens AI Service"
APP_ENV=production
DEBUG=false                       # disables /docs and /redoc
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
# Must match backend AI_SERVICE_API_KEY; requests without it are rejected with 401
AI_SERVICE_API_KEY=CHANGE_ME_LONG_RANDOM
HF_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
HF_HOME=/app/cache/huggingface
# STEP 43: in-process LRU of sentence embeddings (~1.5 KB each). 20000 ≈ 30 MB; 0 disables. Same text → identical vector, results never change.
EMBEDDING_CACHE_SIZE=20000
# Optional Hugging Face token for private/gated models (never expose to the frontend)
HF_TOKEN=
RUBRIC_GENERATION_ENABLED=false
RUBRIC_GENERATION_MODEL=
HF_GENERATION_MODEL=
HF_GENERATION_MAX_NEW_TOKENS=256
CHAT_TOP_K=5
CHAT_MIN_RELEVANCE_SCORE=0.35
CHAT_MAX_CONTEXT_CHARS=6000
CHAT_MAX_HISTORY_MESSAGES=10
QUESTION_GENERATION_MAX_NEW_TOKENS=512
QUESTION_GENERATION_MAX_QUESTIONS=20
RUBRIC_ALIGNMENT_STRONG_THRESHOLD=0.75
RUBRIC_ALIGNMENT_PARTIAL_THRESHOLD=0.55
RUBRIC_ALIGNMENT_WEAK_THRESHOLD=0.35
