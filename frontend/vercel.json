{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://facultylens-api.onrender.com/api/:path*" },
    { "source": "/sanctum/:path*", "destination": "https://facultylens-api.onrender.com/sanctum/:path*" },
    { "source": "/broadcasting/:path*", "destination": "https://facultylens-api.onrender.com/broadcasting/:path*" },
    { "source": "/storage/:path*", "destination": "https://facultylens-api.onrender.com/storage/:path*" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
