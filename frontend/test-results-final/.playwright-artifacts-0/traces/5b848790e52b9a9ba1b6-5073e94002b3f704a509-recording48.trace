50%); border-radius: 9999px; background: rgba(232,236,227,.5); filter: blur(64px); }\n      .boot-inner { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; }\n      .boot-logo { position: relative; display: inline-flex; padding: 14px; border-radius: 9999px; background: #fff; box-shadow: 0 12px 30px -14px rgba(47,62,46,.35); animation: bootLogoIn .6s cubic-bezier(.22,1,.36,1) both; }\n      .boot-halo { position: absolute; inset: 0; border-radius: 9999px; border: 1.5px solid #8C9A82; animation: bootHalo 2s ease-out infinite; }\n      .boot-ring { transform-origin: 50% 50%; animation: bootSpin 4s linear infinite; }\n      .boot-orbit { transform-origin: 50% 50%; animation: bootSpinRev 2s linear infinite; }\n      .boot-glow { transform-origin: 50% 50%; animation: bootGlow 3.2s ease-in-out infinite; }\n      .boot-step { animation: bootStepIn .5s cubic-bezier(.22,1,.36,1) both; }\n      .boot-name { margin: 20px 0 0; font-weight: 700; font-size: 30px; line-height: 1; letter-spacing: -.02em; color: #2F3E2E; animation-delay: .35s; }\n      .boot-text { margin-top: 24px; animation-delay: .7s; }\n      .boot-text strong { display: block; font-size: 14px; font-weight: 600; letter-spacing: -.01em; color: #2F3E2E; }\n      .boot-text span { display: block; margin-top: 6px; font-size: 12px; color: #8C9A82; }\n      .boot-dots i { font-style: normal; animation: bootDot 1.2s ease-in-out infinite; }\n      .boot-dots i:nth-child(2) { animation-delay: .2s; } .boot-dots i:nth-child(3) { animation-delay: .4s; }\n      .boot-track { margin-top: 24px; width: 160px; height: 4px; border-radius: 9999px; background: #E8ECE3; overflow: hidden; animation-delay: .9s; }\n      .boot-bar { width: 33%; height: 100%; border-radius: 9999px; background: linear-gradient(90deg, #C3CBB9, #4A5D45, #C3CBB9); animation: bootBar 1.4s ease-in-out infinite; }\n      @keyframes bootLogoIn { from { opacity: 0; transform: scale(.6); } 60% { transform: scale(1.