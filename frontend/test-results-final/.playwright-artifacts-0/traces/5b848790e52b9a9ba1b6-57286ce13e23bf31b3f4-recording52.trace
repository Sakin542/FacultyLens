white hover:shadow-elevated hover:-translate-y-1 transition-all duration-300 ","style":"transition-delay: 200ms;"},["DIV",{"class":"w-11 h-11 rounded-2xl bg-sage-700 text-white flex items-center justify-center transition-colors group-hover:bg-accent"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.6","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-file-spreadsheet w-5 h-5","aria-hidden":"true"},["path",{"d":"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"}],["path",{"d":"M14 2v4a2 2 0 0 0 2 2h4"}],["path",{"d":"M8 13h2"}],["path",{"d":"M14 13h2"}],["path",{"d":"M8 17h2"}],["path",{"d":"M14 17h2"}]]],["H3",{"class":"mt-4 text-sm font-semibold"},"Institutional Reports"],["P",{"class":"mt-1.5 text-xs text-sage-500 leading-relaxed"},"Export course, department and institution-level evidence — CO/PO coverage, assessment quality and performance — as PDF, CSV or XLSX for reviews and accreditation."]]]]],["SECTION",{"class":"bg-white"},["DIV",{"class":"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20"},["DIV",{"class":"grid grid-cols-1 lg:grid-cols-12 gap-10"},["DIV",{"class":"landing-reveal  lg:col-span-4 space-y-4","style":"transition-delay: 0ms;"},["H2",{"class":"font-serif text-3xl sm:text-4xl lg:text-[2.75rem] leading-[1.1] tracking-tight text-sage-800 "},"Built for people who have to ",["SPAN",{"class":"landing-ink"},"stand behind the result."]],["P",{"class":"text-sm sm:text-base text-sage-500 leading-relaxed "},"An assessment tool for universities cannot be a black box. Faculty defend their papers to students, colleagues, and accreditation bodies — so every output has to be traceable, reversible and yours."]],["DIV",{"class":"lg:col-span-8 grid grid-cols-1 md:grid-cols-3 gap-4"},["DIV",{"class":"landing-reveal  group rounded-[1.5rem] bg-sage-100 p-6 space-y-3","style":"transition-delay: 0ms;"},["DIV",{"class":"w-12 h-12 rou