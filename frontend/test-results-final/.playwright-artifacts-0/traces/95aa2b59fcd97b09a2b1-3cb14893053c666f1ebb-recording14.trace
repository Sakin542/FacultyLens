0%); border-radius: 9999px; background: rgba(232,236,227,.5); filter: blur(64px); }\n      .boot-inner { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; }\n      .boot-logo { position: relative; display: inline-flex; padding: 14px; border-radius: 9999px; background: #fff; box-shadow: 0 12px 30px -14px rgba(47,62,46,.35); animation: bootLogoIn .6s cubic-bezier(.22,1,.36,1) both; }\n      .boot-halo { position: absolute; inset: 0; border-radius: 9999px; border: 1.5px solid #8C9A82; animation: bootHalo 2s ease-out infinite; }\n      .boot-ring { transform-origin: 50% 50%; animation: bootSpin 4s linear infinite; }\n      .boot-orbit { transform-origin: 50% 50%; animation: bootSpinRev 2s linear infinite; }\n      .boot-glow { transform-origin: 50% 50%; animation: bootGlow 3.2s ease-in-out infinite; }\n      .boot-step { animation: bootStepIn .5s cubic-bezier(.22,1,.36,1) both; }\n      .boot-name { margin: 20px 0 0; font-weight: 700; font-size: 30px; line-height: 1; letter-spacing: -.02em; color: #2F3E2E; animation-delay: .35s; }\n      .boot-text { margin-top: 24px; animation-delay: .7s; }\n      .boot-text strong { display: block; font-size: 14px; font-weight: 600; letter-spacing: -.01em; color: #2F3E2E; }\n      .boot-text span { display: block; margin-top: 6px; font-size: 12px; color: #8C9A82; }\n      .boot-dots i { font-style: normal; animation: bootDot 1.2s ease-in-out infinite; }\n      .boot-dots i:nth-child(2) { animation-delay: .2s; } .boot-dots i:nth-child(3) { animation-delay: .4s; }\n      .boot-track { margin-top: 24px; width: 160px; height: 4px; border-radius: 9999px; background: #E8ECE3; overflow: hidden; animation-delay: .9s; }\n      .boot-bar { width: 33%; height: 100%; border-radius: 9999px; background: linear-gradient(90deg, #C3CBB9, #4A5D45, #C3CBB9); animation: bootBar 1.4s ease-in-out infinite; }\n      @keyframes bootLogoIn { from { opacity: 0; transform: scale(.6); } 60% { transform: scale(1.06); } to { opacity: 1; transform: scale(1); } }\n      @keyframes bootStepIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }\n      @keyframes bootHalo { 0% { transform: scale(.7); opacity: .55; } 100% { transform: scale(1.9); opacity: 0; } }\n      @keyframes bootSpin { to { transform: rotate(360deg); } } @keyframes bootSpinRev { to { transform: rotate(-360deg); } }\n      @keyframes bootGlow { 0%,100% { opacity: .35; transform: scale(.9); } 50% { opacity: .7; transform: scale(1.08); } }\n      @keyframes bootBar { from { transform: translateX(-120%); } to { transform: translateX(420%); } }\n      @keyframes bootDot { 0%,80%,100% { opacity: .2; } 40% { opacity: 1; } }\n      @media (prefers-reduced-motion: reduce) { #boot * { animation: none !important; } .boot-halo { display: none; } }\n    "],"\n    ","\n    ",["LINK",{"rel":"stylesheet","crossorigin":"","href":"/assets/index-CDmCeQQr.css"}],"\n  "],"\n  ",["BODY",{"class":"antialiased min-h-screen"},"\n    ",["DIV",{"id":"root"},["DIV",{"class":"min-h-screen flex flex-col items-center justify-center bg-[#FAF9F6] p-6 relative overflow-hidden splash-seamless","role":"status","aria-live":"polite","aria-label":"Verifying institutional session"},["DIV",{"class":"pointer-events-none absolute inset-0 opacity-60","aria-hidden":"true","style":"background-image: radial-gradient(rgb(232, 236, 227) 1px, transparent 1px); background-size: 22px 22px;"}],["DIV",{"class":"pointer-events-none absolute -top-32 left-1/2 -translate-x-1/2 h-96 w-96 rounded-full bg-sage-200/50 blur-3xl","aria-hidden":"true"}],["DIV",{"class":"relative flex flex-col items-center text-center"},["DIV",{"class":"splash-logo group"},["SPAN",{"class":"splash-halo","aria-hidden":"true"}],["SPAN",{"class":"relative inline-flex items-center justify-center shrink-0 transition-transform duration-500 group-hover:rotate-6 ","aria-hidden":"true","style":"width: 72px; height: 72px;"},["svg",{"viewBox":"0 0 48 48","width":"72