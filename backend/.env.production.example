# FacultyLens backend — PRODUCTION template (copy to .env on the server; never commit the real file)
# Every secret below must be generated/provided by the operator. Values marked CHANGE_ME are placeholders.

APP_NAME=FacultyLens
APP_ENV=production
APP_KEY=                       # php artisan key:generate --show   (CHANGE_ME)
APP_DEBUG=false
APP_URL=https://facultylens.example.edu
FRONTEND_URL=https://facultylens.example.edu
# Comma-separated list of browser origins allowed to call the API with credentials (no wildcard)
CORS_ALLOWED_ORIGINS=https://facultylens.example.edu
# Hosts whose cookies are accepted by Sanctum (frontend host[:port])
SANCTUM_STATEFUL_DOMAINS=facultylens.example.edu
SESSION_DOMAIN=facultylens.example.edu
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120
# Reverse proxy (nginx) terminates TLS; trust its forwarded headers. Use the proxy IP/CIDR, not * if possible.
TRUSTED_PROXIES=172.16.0.0/12

LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_REQUESTS=true
LOG_SLOW_REQUEST_MS=2000

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=facultylens
DB_USERNAME=facultylens_app         # least-privilege user (no SUPER/FILE/PROCESS grants)
DB_PASSWORD=CHANGE_ME

CACHE_STORE=redis
QUEUE_CONNECTION=redis
# STEP 43: must exceed the longest job timeout (RunAiEvaluationJob 1800 s); worker blocks on Redis up to 5 s instead of polling
REDIS_QUEUE_RETRY_AFTER=1900
REDIS_QUEUE_BLOCK_FOR=5
# STEP 43: php-fpm pool rendered by the entrypoint (~40 MB per worker with opcache; 32 ≈ 1.3 GB). Default image value (5) capped the API at 5 concurrent requests.
PHP_FPM_MAX_CHILDREN=32
PHP_FPM_START_SERVERS=8
PHP_FPM_MIN_SPARE=4
PHP_FPM_MAX_SPARE=16
SESSION_DRIVER=database
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379

FILESYSTEM_DISK=local
REPORTS_DISK=local
REPORTS_EXPIRATION_DAYS=7
REPORTS_ASYNC_THRESHOLD=2000

# Internal-only AI service (not reachable from the internet). Same key must be set in ai-service.
AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_API_KEY=CHANGE_ME_LONG_RANDOM
AI_SERVICE_CONNECT_TIMEOUT=10
AI_SERVICE_TIMEOUT=120

MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@facultylens.example.edu
MAIL_FROM_NAME="${APP_NAME}"

# Feature rate limits (per user per minute unless noted)
CHAT_RATE_LIMIT=30
QUESTION_GENERATION_RATE_LIMIT=10
COLLABORATION_INVITE_RATE_LIMIT=10
COLLABORATION_COMMENT_RATE_LIMIT=60

# Never set in production
ALLOW_DEV_SEED=false
