APP_NAME=FacultyLens
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080

FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=facultylens
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Queue: redis + Laravel Horizon (docker-compose `redis` + `horizon` services). `database` still works with queue:work.
QUEUE_CONNECTION=redis

# STEP 47 notification system (all optional; defaults shown)
# NOTIFICATIONS_QUEUE_ENABLED=true          # false = write notifications inline instead of via the queue
# NOTIFICATIONS_QUEUE_CONNECTION=           # empty = QUEUE_CONNECTION
# NOTIFICATIONS_QUEUE=default
# NOTIFICATIONS_POLL_INTERVAL=45            # seconds hinted to the frontend poller
# NOTIFICATIONS_FAILED_LOGIN_THRESHOLD=5    # SECURITY_ALERT after this many failed sign-ins per account/window
# NOTIFICATIONS_FAILED_LOGIN_WINDOW=15      # minutes
# NOTIFICATIONS_READ_RETENTION_DAYS=90      # notifications:purge; 0 disables
# NOTIFICATIONS_MAX_RETENTION_DAYS=365
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# E-mail (Gmail SMTP). The sender account is configured ONLY here. MAIL_PASSWORD is a Gmail *App Password*
# (Google Account → Security → 2-Step Verification → App passwords); it is entered in the local .env and never
# committed, logged, or returned by any API. `php artisan email:check` prints this block with the password masked.
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=saomiorashid542@gmail.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=saomiorashid542@gmail.com
MAIL_FROM_NAME="FacultyLens"
# Local capture instead of Gmail (docker-compose `mailpit` service, UI http://localhost:8025): MAIL_MAILER=mailpit
# MAILPIT_HOST=mailpit
# MAILPIT_PORT=1025

# FacultyLens e-mail system (all optional; defaults shown)
# EMAIL_ENABLED=true                        # false = no e-mail is queued; in-app notifications unaffected
# EMAIL_QUEUE=emails                        # Horizon supervisor-emails consumes this queue
# EMAIL_QUEUE_CONNECTION=                   # empty = QUEUE_CONNECTION
# EMAIL_QUEUE_TRIES=4
# EMAIL_QUEUE_TIMEOUT=90
# EMAIL_RATE_LIMIT_PER_USER_PER_HOUR=30
# EMAIL_SECURITY_RATE_LIMIT_PER_USER_PER_HOUR=20
# EMAIL_BURST_WINDOW_SECONDS=20
# EMAIL_BURST_MAX_PER_TYPE=5
# EMAIL_DELIVERY_RETENTION_DAYS=180
# EMAIL_TEST_ENDPOINT_ENABLED=              # default: true outside production (POST /api/email/test)
# EMAIL_PREVIEW_ENABLED=                    # default: true outside production (GET /api/email/preview/{template})
# EMAIL_TEST_RATE_LIMIT_PER_HOUR=5
# EMAIL_LIVE_TESTING=false                  # true = the single live SMTP phpunit test runs (never in CI)

# Horizon (queue dashboard at /horizon; ADMIN accounts only outside local)
# HORIZON_DEFAULT_PROCESSES=4
# HORIZON_EMAIL_PROCESSES=2
# HORIZON_DEFAULT_TIMEOUT=900
# HORIZON_EMAIL_TIMEOUT=120

# AI Service Configuration
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_API_KEY=
AI_SERVICE_TIMEOUT=30

# STEP 32 AI Chat with Academic Documents (RAG)
# Chunking is word-based (700 words ≈ 900 tokens); overlap keeps context across chunk borders.
CHAT_CHUNK_SIZE=700
CHAT_CHUNK_OVERLAP=120
# Retrieval: top-K chunks sent to the AI service; cosine threshold on MiniLM embeddings (engineering value).
CHAT_TOP_K=5
CHAT_MIN_RELEVANCE_SCORE=0.35
CHAT_MAX_HISTORY_MESSAGES=10
MAX_CHAT_QUESTION_LENGTH=5000
# Messages per minute per user
CHAT_RATE_LIMIT=30
CHAT_EMBEDDING_BATCH_SIZE=64
# Bump to force re-indexing of all documents
CHAT_INDEXING_VERSION=1

# STEP 33 Constrained Question Generator
QUESTION_GENERATION_MAX_QUESTIONS=20
QUESTION_GENERATION_MAX_MARKS=100
QUESTION_GENERATION_MAX_REGENERATIONS=3
# Generation requests per minute per user (stricter than normal API calls)
QUESTION_GENERATION_RATE_LIMIT=10
# Document passages retrieved (STEP 32 RAG) to ground drafts
QUESTION_GENERATION_DOC_TOP_K=6
QUESTION_GENERATION_DOC_MIN_RELEVANCE=0.25
QUESTION_GENERATION_MAX_EXISTING=300

# STEP 34 Faculty Collaboration
# Invitation links point at the frontend (FRONTEND_URL above); emails use MAIL_MAILER (log/array = link returned in API response for local dev)
COLLABORATION_INVITATION_EXPIRES_DAYS=7
COLLABORATION_INVITE_RATE_LIMIT=10
COLLABORATION_COMMENT_RATE_LIMIT=60
COLLABORATION_MAX_COLLABORATORS=50
COLLABORATION_VIEWER_CAN_COMMENT=false

# STEP 35 AI Evaluation & Model Performance (monitoring only — never retrains, re-thresholds or promotes models)
AI_EVALUATION_ENABLED=true
AI_EVALUATION_BATCH_SIZE=32
AI_EVALUATION_MAX_EXAMPLES=5000
AI_EVALUATION_MIN_EXAMPLES_WARNING=30
# Engineering quality gates (not academic validity claims)
AI_EVAL_GATE_QUESTION_F1=0.80
AI_EVAL_GATE_DIFFICULTY_F1=0.70
AI_EVAL_GATE_BLOOM_F1=0.75
AI_EVAL_GATE_LO_F1=0.75
AI_EVAL_GATE_SIMILARITY_F1=0.80
AI_EVAL_GATE_GRADING_MAE=1.0
AI_EVAL_GATE_RAG_CITATION=0.90
AI_EVAL_GATE_QGEN_CSR=0.90

# STEP 36 Academic Analytics Dashboard (read-only aggregates; cache key includes a data-version fingerprint)
ANALYTICS_CACHE_TTL=300
ANALYTICS_DIFFICULTY_TARGET_EASY=30
ANALYTICS_DIFFICULTY_TARGET_MEDIUM=50
ANALYTICS_DIFFICULTY_TARGET_HARD=20
# Total absolute deviation bands (45 mirrors the STEP 13 quality-engine rule)
ANALYTICS_DIFFICULTY_SLIGHT_DEVIATION=15
ANALYTICS_DIFFICULTY_SIGNIFICANT_DEVIATION=45
ANALYTICS_MIN_COGNITIVE_LEVELS=3
ANALYTICS_TOP_GAPS_LIMIT=5

# STEP 37 Assessment Blueprint (deterministic planning validation; no AI calls)
# |target - actual| <= tolerance → CLOSE, otherwise MISMATCH
BLUEPRINT_PERCENTAGE_TOLERANCE=5
BLUEPRINT_TOTAL_ROUNDING_TOLERANCE=0.5
# Planning indicator bands (minutes per mark); not an official duration recommendation
BLUEPRINT_MIN_MINUTES_PER_MARK=1.0
BLUEPRINT_MAX_MINUTES_PER_MARK=3.0
BLUEPRINT_DIFFICULTY_WARNING_DEVIATION=15
BLUEPRINT_LOW_COVERAGE_PERCENT=10

# STEP 30: Student Performance / Gap Analysis (initial engineering thresholds; calibrate per institution)
PERFORMANCE_EXPECTED_PERCENT=70
PERFORMANCE_STRONG_PERCENT=80
PERFORMANCE_GAP_LOW=5
PERFORMANCE_GAP_MODERATE=10
PERFORMANCE_GAP_HIGH=20
PERFORMANCE_MIN_RESPONSES=5
PERFORMANCE_ASYNC_THRESHOLD=500

# STEP 31: CO/PO Mapping Validator (review-signal thresholds; not accreditation requirements)
COPO_CO_MIN_COVERAGE_PERCENT=5
COPO_CO_CONCENTRATION_PERCENT=60
COPO_PO_EVIDENCE_MIN_PERCENT=10
COPO_MAPPING_DENSITY_REVIEW_PERCENT=90
