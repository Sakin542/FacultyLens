# FacultyLens backend — production image (php-fpm, no dev dependencies, no artisan serve)
FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --no-progress --prefer-dist --optimize-autoloader --no-scripts --ignore-platform-reqs

FROM php:8.2-fpm-alpine

RUN apk add --no-cache bash curl mariadb-client libzip-dev libpng-dev libjpeg-turbo-dev freetype-dev libxml2-dev oniguruma-dev icu-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" pdo_mysql mbstring bcmath xml zip gd intl opcache pcntl \
    && rm -rf /tmp/*

# Production PHP settings: opcache on, no error display, sane upload limits (documents up to 20 MB)
RUN { \
      echo "opcache.enable=1"; echo "opcache.validate_timestamps=0"; echo "opcache.memory_consumption=192"; echo "opcache.max_accelerated_files=20000"; \
      echo "display_errors=Off"; echo "expose_php=Off"; echo "log_errors=On"; \
      echo "upload_max_filesize=25M"; echo "post_max_size=26M"; echo "memory_limit=512M"; echo "max_execution_time=120"; \
    } > /usr/local/etc/php/conf.d/facultylens.ini

WORKDIR /var/www/html
COPY --chown=www-data:www-data . /var/www/html
COPY --from=vendor --chown=www-data:www-data /app/vendor /var/www/html/vendor
COPY deploy/docker/entrypoint.sh /usr/local/bin/facultylens-entrypoint
RUN chmod +x /usr/local/bin/facultylens-entrypoint \
    && mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views storage/logs storage/app/private bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chown -R www-data:www-data /usr/local/etc/php-fpm.d \
    && composer --version >/dev/null 2>&1 || true

USER www-data
EXPOSE 9000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD php -r 'exit(@fsockopen("127.0.0.1", 9000) ? 0 : 1);'
ENTRYPOINT ["facultylens-entrypoint"]
CMD ["php-fpm"]
