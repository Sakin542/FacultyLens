# Compose-level variables for docker-compose.prod.yml (copy to .env next to the compose file).
# Application secrets live in backend/.env and ai-service/.env (see their .env.production.example files).
IMAGE_TAG=latest
VITE_API_BASE_URL=/api
TLS_CERT_DIR=./deploy/certs          # must contain fullchain.pem and privkey.pem
DB_DATABASE=facultylens
DB_USERNAME=facultylens_app
DB_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
